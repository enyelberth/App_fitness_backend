{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/main.ts",
    "src/app.module.ts",
    "src/config/**/*.ts",
    "src/database/**/*.ts",
    "src/common/**/*.ts",
    "src/modules/health/**/*.ts",
    "src/modules/auth/**/*.ts",
    "src/modules/users/**/*.ts",
    "src/modules/payments/**/*.ts",
    "src/modules/economy/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
