generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  COACH
  ADMIN
}

enum UserLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum FitnessGoal {
  LOSE_FAT
  GAIN_MUSCLE
  GET_STRONGER
  GET_HEALTHIER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PaymentStatus {
  CREATED
  APPROVED
  COMPLETED
  CANCELLED
  FAILED
  REFUNDED
}

enum WalletEntryType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

enum UserFavoriteType {
  EXERCISE
  WORKOUT
}

enum RPEScale {
  RPE_1
  RPE_2
  RPE_3
  RPE_4
  RPE_5
  RPE_6
  RPE_7
  RPE_8
  RPE_9
  RPE_10
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  PAUSED
}

enum DiscomfortType {
  MILD_DISCOMFORT
  PAIN
  SHARP_PAIN
  PINCHING
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile              Profile?
  sessions             AuthSession[]
  workouts             Workout[]
  progressEntries      ProgressEntry[]
  payments             Payment[]
  wallet               Wallet?
  ratings              ExerciseRating[]
  favorites            UserFavorite[]
  workoutSessions      WorkoutSession[] @relation("WorkoutSessions")
  createdWorkoutTemplate WorkoutTemplate[] @relation("CreatedTemplates")

  @@index([role])
  @@index([deletedAt])
  @@map("app_users")
}

model Profile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  firstName          String?
  lastName           String?
  avatarUrl          String?
  bio                String?
  age                Int?
  gender             Gender?
  weightKg           Decimal?    @db.Decimal(6, 2)
  heightCm           Decimal?    @db.Decimal(6, 2)
  level              UserLevel   @default(BEGINNER)
  goal               FitnessGoal @default(GET_HEALTHIER)
  availableEquipment String[]    @default([])
  availableMinutes   Int?
  injuries           String[]    @default([])
  preferences        String[]    @default([])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_profiles")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Exercise {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  muscles         ExerciseMuscle[]
  workoutItems    WorkoutExercise[]
  progressEntries ProgressEntry[]
  variations      ExerciseVariation[]
  ratings         ExerciseRating[]
  favorites       UserFavorite[]
  sessionSets     WorkoutSessionSet[]

  @@map("exercises")
}

model MuscleGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises ExerciseMuscle[]

  @@map("muscle_groups")
}

model ExerciseMuscle {
  exerciseId    String
  muscleGroupId String
  isPrimary     Boolean @default(false)

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
  @@map("exercise_muscles")
}

model Workout {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?
  difficulty  Difficulty @default(BEGINNER)
  durationMin Int?
  isTemplate  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  sessions  WorkoutSession[]
  favorites UserFavorite[]

  @@index([userId])
  @@index([deletedAt])
  @@map("workouts")
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  position   Int
  sets       Int?
  reps       Int?
  weightKg   Decimal? @db.Decimal(7, 2)
  restSec    Int?
  notes      String?

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutId, position])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model ProgressEntry {
  id          String   @id @default(cuid())
  userId      String
  exerciseId  String?
  weightKg    Decimal? @db.Decimal(7, 2)
  bodyFatPct  Decimal? @db.Decimal(5, 2)
  sets        Int?
  reps        Int?
  notes       String?
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([userId, performedAt])
  @@index([exerciseId])
  @@map("progress_entries")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  provider          String        @default("PAYPAL")
  externalOrderId   String        @unique
  externalCaptureId String?       @unique
  idempotencyKey    String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.VarChar(3)
  status            PaymentStatus @default(CREATED)
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletEntries WalletEntry[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WalletEntry[]

  @@map("wallets")
}

model WalletEntry {
  id             String          @id @default(cuid())
  walletId       String
  paymentId      String?
  type           WalletEntryType
  amount         Int
  reason         String
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([paymentId])
  @@map("wallet_entries")
}

model ExerciseVariation {
  id          String   @id @default(cuid())
  exerciseId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, name])
  @@map("exercise_variations")
}

model ExerciseRating {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  rating     Int
  review     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([exerciseId])
  @@map("exercise_ratings")
}

model UserFavorite {
  id         String             @id @default(cuid())
  userId     String
  type       UserFavoriteType
  exerciseId String?
  workoutId  String?
  createdAt  DateTime           @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workout  Workout?  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([userId, type, exerciseId, workoutId])
  @@index([userId])
  @@map("user_favorites")
}

model WorkoutSession {
  id        String        @id @default(cuid())
  workoutId String
  userId    String
  startedAt DateTime
  endedAt   DateTime?
  status    SessionStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime      @default(now())

  workout       Workout              @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user          User                 @relation("WorkoutSessions", fields: [userId], references: [id], onDelete: Cascade)
  sets          WorkoutSessionSet[]
  discomforts   SessionDiscomfort[]

  @@index([workoutId])
  @@index([userId])
  @@index([status])
  @@map("workout_sessions")
}

model WorkoutSessionSet {
  id               String   @id @default(cuid())
  sessionId        String
  exerciseId       String
  setsCompleted    Int
  repsPerformed    Int[]
  weightUsed       Decimal? @db.Decimal(7, 2)
  rpe              Int?
  plannedRestSec   Int?
  actualRestSec    Int?
  isWarmupSet      Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("workout_session_sets")
}

model SessionDiscomfort {
  id        String         @id @default(cuid())
  sessionId String
  bodyPart  String
  type      DiscomfortType
  severity  Int
  notes     String?
  createdAt DateTime       @default(now())

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_discomforts")
}

model WorkoutTemplate {
  id          String     @id @default(cuid())
  createdBy   String
  name        String
  description String?
  difficulty  Difficulty @default(BEGINNER)
  durationMin Int?
  exercises   Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  creator User @relation("CreatedTemplates", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@map("workout_templates")
}

// ============= GAME MODULE =============

model GameCharacter {
  id            String    @id @default(cuid())
  userId        String    @unique

  class         String    @default("WARRIOR")
  level         Int       @default(1)
  currentXp     Int       @default(0)
  totalXp       Int       @default(0)

  health        Int       @default(100)
  strength      Int       @default(10)
  speed         Int       @default(10)
  stamina       Int       @default(10)

  prestigeLevel Int       @default(0)
  totalWorkouts Int       @default(0)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory     GameInventory[]
  leaderboard   GameLeaderboardEntry?
  quests        GameQuest[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([level])
  @@map("game_characters")
}

model GameQuest {
  id            String    @id @default(cuid())
  userId        String

  title         String
  description   String?
  type          String    @default("DAILY")
  requirement   String
  targetValue   Int
  currentProgress Int     @default(0)

  status        String    @default("ACTIVE")
  xpReward      Int
  coinReward    Int
  gemReward     Int?

  character     GameCharacter @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  expiresAt     DateTime

  @@index([userId])
  @@index([type])
  @@map("game_quests")
}

model GameCosmetic {
  id            String    @id @default(cuid())
  name          String
  description   String?
  type          String
  rarity        String    @default("COMMON")

  characterClass String?
  price         Int?
  gemPrice      Int?

  imageUrl      String?

  inventory     GameInventory[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([type])
  @@index([rarity])
  @@map("game_cosmetics")
}

model GameInventory {
  id            String    @id @default(cuid())
  userId        String
  cosmeticId    String

  quantity      Int       @default(1)
  equipped      Boolean   @default(false)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic      GameCosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  acquiredAt    DateTime  @default(now())

  @@unique([userId, cosmeticId])
  @@index([userId])
  @@map("game_inventory")
}

model GameLeaderboardEntry {
  id            String    @id @default(cuid())
  userId        String    @unique
  characterId   String    @unique

  rank          Int?
  score         Int

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character     GameCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  updatedAt     DateTime  @updatedAt

  @@index([score])
  @@map("game_leaderboard")
}

// ============= ECONOMY MODULE =============

model GameWallet {
  id            String    @id @default(cuid())
  userId        String    @unique

  coins         Int       @default(100)
  gems          Int       @default(0)

  user          User      @relation("GameWallet", fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("game_wallets")
}

model GameTransaction {
  id            String    @id @default(cuid())
  userId        String

  type          String
  amount        Int
  source        String
  description   String

  balance       Int

  user          User      @relation("GameTransactions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([source])
  @@map("game_transactions")
}

// ============= PAYMENTS EXTENDED =============

model GamePayment {
  id            String    @id @default(cuid())
  userId        String

  orderId       String    @unique
  type          String
  amount        Float
  status        String    @default("PENDING")

  user          User      @relation("GamePayments", fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  @@index([userId])
  @@index([status])
  @@map("game_payments")
}
