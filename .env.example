NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://fitness:change_me@localhost:5432/app_fitness?schema=public

# Authentication
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_REFRESH_TTL_SECONDS=604800

# PayPal sandbox
PAYPAL_API=https://api-m.sandbox.paypal.com
PAYPAL_API_CLIENT=your_paypal_sandbox_client_id
PAYPAL_API_SECRET=your_paypal_sandbox_secret
PAYPAL_RETURN_URL=http://localhost:4000/api/v1/payments/paypal/capture
PAYPAL_CANCEL_URL=http://localhost:3000/payments/cancelled

# Browser clients allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
